# Backup-file patterns that litter the live config dirs — never commit these.
*.bak
*.bak.*
*.omarchy-upgrade-to-quattro.*

# Albion harness session state (goal tracking) — never stage.
.albion/

# PKGBUILD build artifacts and the AUR clone's git dir (kept local only).
pkgbuilds/*/src/
pkgbuilds/*/pkg/
pkgbuilds/*/*.pkg.tar.zst
pkgbuilds/*/*.pkg.tar.zst.sig
pkgbuilds/*/.git/

# makepkg git-source cache (bare clone of nemo-extensions)
pkgbuilds/*/nemo-extensions/
